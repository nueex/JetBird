<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#EDEDEF</item>
        <item name="android:colorAccent">#222222</item>
        <item name="android:fontFamily">@font/app_ui</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="PopupMotion">
        <item name="android:windowEnterAnimation">@anim/popup_enter</item>
        <item name="android:windowExitAnimation">@anim/popup_exit</item>
    </style>
    <style name="DialogMotion">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
    <style name="BottomSheetMotion">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
    <style name="AppDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">@font/app_ui</item>
        <item name="android:windowAnimationStyle">@style/DialogMotion</item>
    </style>
    <style name="AppDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/app_ui</item>
        <item name="android:windowAnimationStyle">@style/DialogMotion</item>
    </style>
</resources>
